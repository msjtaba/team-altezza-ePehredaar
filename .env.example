# Postgres (see prisma/schema.prisma — provider is "postgresql"). Use a
# real Postgres connection string here (the deployed app uses the Prisma
# Postgres instance provisioned via Vercel's marketplace integration —
# pull it locally with `vercel env pull` rather than retyping it by hand).
DATABASE_URL="postgres://user:password@host:5432/dbname"
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
